# Kopieren nach .env und anpassen:   cp .env.example .env
# Die Datei .env enthält Passwörter – niemals ins Git einchecken!

# Datenbank-Passwort. Nur Buchstaben/Ziffern verwenden (steht in einer URL).
# Erzeugen z. B. mit:  openssl rand -hex 24
DB_PASSWORD=

# Adresse, unter der die Weboberfläche erreichbar ist (IP oder Name des NAS/Pi + Port)
SITE_ADDRESS=https://192.168.178.10:8443

# Netze, die gescannt werden dürfen (kommagetrennt, max. /16 je Netz).
# Nur beim allerersten Start übernommen, danach in der Oberfläche unter „Netzwerke“ pflegen.
# ACHTUNG: Nur eigene bzw. ausdrücklich freigegebene Netze eintragen!
SCAN_NETWORKS=192.168.178.0/24

# Erster Admin. Bleibt das Passwort leer, wird eines erzeugt und einmalig ins Log geschrieben:
#   docker compose logs app | grep Passwort
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# Intervalle
DISCOVERY_INTERVAL_MIN=15
# Zeitzone für den Such-Zeitplan
TZ=Europe/Berlin
MONITOR_INTERVAL_SEC=60

# Abstand der tiefen Abfragen per SNMP/SSH in Minuten
INVENTORY_INTERVAL_MIN=5

# Aufbewahrungsfristen in Tagen (Datenschutz: so kurz wie möglich, so lang wie nötig)
RETENTION_METRICS_DAYS=90
RETENTION_EVENTS_DAYS=180
RETENTION_AUDIT_DAYS=365

# Ports auf dem Host (nur ändern, wenn belegt)
# DB_PORT=5433
# APP_PORT=18080

# Eingang für Nginx Proxy Manager o. Ä. (z. B. http://:18081); Standard nur lokal
# Am besten die LAN-Adresse des Hosts, z. B. http://192.168.178.10:18081 – nie am Router freigeben
PROXY_LISTEN=http://127.0.0.1:18081

# Empfang von Syslog (UDP) und SNMP-Traps (UDP); 0 = aus
SYSLOG_PORT=5514
TRAP_PORT=1162
# Nur Traps mit dieser Community annehmen (leer = alle)
# Absender für Syslog/Traps: Netze (CIDR, Komma) oder "any"; leer = nur aus den Scan-Netzen
SYSLOG_ALLOW=
TRAP_COMMUNITY=
RETENTION_SYSLOG_DAYS=30
